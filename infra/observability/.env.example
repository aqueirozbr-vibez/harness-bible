# Copy to infra/observability/.env (git-ignored by the repository's `.env*` rule) and fill it yourself; never paste a
# key anywhere else. The compose `otel-collector` service reads it (env_file, optional) and nothing else does: the
# collector is the one road to Langfuse (feature-specs/49 § 2, § 4). The web tier, the workers and the gateway hold no
# Langfuse key; compose blanks the gateway's.
#
# Without this file, or with LANGFUSE_OTLP_ENDPOINT or LANGFUSE_TRACING_ENVIRONMENT empty, nothing goes to Langfuse:
# the collector drops every span on that road before its exporter, and Tempo and Loki work as before (§ 5.5, § 15).
# After a change, recreate the collector: `docker compose --profile observe up -d --force-recreate otel-collector`.

# The Langfuse project's API keys (the project's settings, API Keys), sent as HTTP Basic: the public key the user,
# the secret key the password.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# The project's OTLP endpoint, without a trailing slash; the collector adds `/v1/traces`. The development project is
# in the US region (D4, Andre, 2026-10-14): https://us.cloud.langfuse.com/api/public/otel
# A self-hosted Langfuse (3.22 or later) is https://<host>/api/public/otel; moving there changes this line and the
# two keys, nothing else (§ 14). Empty it to stop the export.
LANGFUSE_OTLP_ENDPOINT=

# The environment every span is labelled with in Langfuse: `development` on this machine. Unset, nothing is sent; and
# the collector sends to Langfuse Cloud (any *.cloud.langfuse.com endpoint) only spans labelled `development`, so a
# deployment's name here with a Cloud endpoint sends nothing (Andre's L1: production never leaves the region).
LANGFUSE_TRACING_ENVIRONMENT=

# The collector's half of the development-only text switch (§ 9.1): `on` or `off`, unset meaning `off`. Only `on`
# lets a successful generation's prompt and answer through, and only while the workers' half, LANGFUSE_MESSAGE_TEXT
# in the project .env, is on behind its development check (unit 82). A failed call's text and the evidence grader's
# PDF or image row never go, whatever this says. Before any real reader uses the app, `off` (§ 10).
LANGFUSE_MESSAGE_TEXT=
