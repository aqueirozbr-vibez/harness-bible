# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
# The public half of the ledger export key is part of the repository (feature-specs/14 § 7); the private half stays ignored.
!infra/ledger/export-public.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# ingestion reports and the generated Prisma client
/pipeline/reports/
/lib/db/generated/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Keycloak vault files (feature-specs/09 ? 8.5)
infra/keycloak/vault/
infra/keycloak/.rendered/

# the lines the observability stack's collector reads in development (feature-specs/21 § 5.2)
/var/

# Playwright (npm run test:layout)
/test-results/
/playwright-report/

# object storage as a directory (feature-specs/32 § 5; OBJECT_STORE_DIR)
.store/
