{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,opa,stub -c auto \"next dev\" \"npm run policy:serve\" \"npm run gateway:stub\"",
    "dev:next": "next dev",
    "policy:serve": "opa run --server --addr 127.0.0.1:8181 policies",
    "policy:check": "opa check policies",
    "policy:test": "opa test policies -v",
    "roster:set": "tsx scripts/roster-set.ts",
    "rubric:pin": "tsx scripts/rubric-pin.ts",
    "rubric:publish": "tsx scripts/rubric-publish.ts",
    "improve:seed": "tsx scripts/improve-seed.ts",
    "research:seed": "tsx scripts/research-seed.ts",
    "gateway:stub": "tsx scripts/gateway-stub.ts",
    "gateway:key": "tsx scripts/gateway-key.ts",
    "gateway:check": "tsx scripts/gateway-check.ts",
    "workers": "tsx workers/main.ts",
    "workflows:check": "tsx scripts/workflows-check.ts",
    "workflows:test-server": "tsx scripts/workflows-test-server.ts",
    "fetch:check": "tsx scripts/fetch-check.ts",
    "grade:check": "tsx scripts/grade-check.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:ledger": "vitest run lib/ledger --coverage",
    "test:rubric": "vitest run lib/rubric --coverage --coverage.include=lib/rubric/**",
    "test:layout": "playwright test tests/layout",
    "test:e2e": "playwright test tests/e2e",
    "test:research": "vitest run tests/research/",
    "ingest": "cross-env PIPELINE=1 tsx pipeline/ingest.ts",
    "embed:release": "cross-env EMBED=1 tsx scripts/embed-release.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "auth:kc": "node infra/keycloak/start.mjs",
    "auth:kc:render": "node infra/keycloak/start.mjs --render-only",
    "auth:kc:fake": "node infra/keycloak/fake-idp.mjs",
    "auth:kc:walk": "node scripts/auth-kc-walk.mjs",
    "assistant:metrics": "tsx scripts/assistant-metrics.ts",
    "assistant:purge": "tsx scripts/assistant-purge.ts",
    "auth:sweep": "tsx scripts/auth-sweep.ts",
    "api:openapi": "tsx scripts/api-openapi.ts",
    "gate:golden": "tsx scripts/golden-run.ts",
    "gate:phase1": "tsx scripts/phase1-gate.ts",
    "gate:phase2": "tsx scripts/phase2-gate.ts",
    "gate:phase4": "tsx scripts/phase4-gate.ts",
    "gate:research": "tsx scripts/research-gate.ts",
    "gate:suggestions": "tsx scripts/golden-suggestions.ts",
    "gate:suggestions:run": "tsx scripts/golden-suggestions-run.ts",
    "research:org": "tsx scripts/research-org.ts",
    "research:check": "tsx scripts/research-check.ts",
    "research:metrics": "tsx scripts/research-metrics.ts",
    "gate:show": "tsx scripts/gate-show.ts",
    "observe:generate": "tsx scripts/observe-generate.ts",
    "secrets:scan": "tsx scripts/secret-scan.ts",
    "audit:check": "tsx scripts/audit-check.ts",
    "golden:assistant": "tsx scripts/golden-assistant.ts",
    "guides:pin": "tsx scripts/guides-pin.ts",
    "ledger:export": "tsx scripts/ledger-export.ts",
    "ledger:keygen": "tsx scripts/ledger-keygen.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace": "2.11.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.3",
    "jose": "^6.2.12",
    "marked": "^18.0.14",
    "next": "16.4.2",
    "next-intl": "^4.14.6",
    "openid-client": "^6.8.8",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@temporalio/testing": "1.24.0",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "mermaid": "^12.0.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.4",
    "vitest": "^5.0.1"
  }
}
